<%# Feature 2.1 ✯ - Front page navigation %>
<%# Feature 2.5 - Pagination %>

<% content_for :title, "Shop All Products - Scented Studio" %>

<%# Hero Section %>
<section class="bg-light py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-4 fw-bold mb-3">Welcome to Scented Studio</h1>
        <p class="lead text-muted mb-4">
          Discover our handcrafted collection of artisan candles, wax melts, essential oils, and home fragrances. 
          Each product is lovingly made in Winnipeg with natural ingredients.
        </p>
        <div class="d-flex gap-2">
          <%= link_to "Shop Now", "#products", class: "btn btn-primary btn-lg" %>
          <%= link_to "Learn More", "#", class: "btn btn-outline-secondary btn-lg" %>
        </div>
      </div>
      <div class="col-lg-6 text-center mt-4 mt-lg-0">
        <div class="p-5">
          <i class="bi bi-flower1" style="font-size: 10rem; color: var(--bs-primary);"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Products Section %>
<section class="py-5" id="products">
  <div class="container">
    <div class="row mb-4">
      <div class="col-md-8">
        <h2 class="mb-3">Our Products</h2>
        <p class="text-muted">Browse our complete collection of <%= @products.total_count %> handcrafted products</p>
      </div>
      <div class="col-md-4 text-md-end">
        <div class="btn-group" role="group">
          <%= link_to "All Products", products_path, class: "btn btn-outline-primary active" %>
        </div>
      </div>
    </div>

    <%# Feature 2.6 ✯ - Search by category %>
    <div class="card mb-4">
      <div class="card-body">
        <%= form_with url: products_path, method: :get, local: true, class: "row g-3" do |f| %>
          <div class="col-md-5">
            <label for="search" class="form-label">Search Products</label>
            <%= f.text_field :search, 
                value: params[:search], 
                class: "form-control", 
                placeholder: "Search by name or description...",
                id: "search" %>
          </div>
          <div class="col-md-4">
            <label for="category_id" class="form-label">Filter by Category</label>
            <%= f.select :category_id, 
                options_for_select([["All Categories", "all"]] + @categories.map { |c| [c.name, c.id] }, params[:category_id] || "all"),
                {},
                class: "form-select",
                id: "category_id" %>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <%= f.submit "Search", class: "btn btn-primary me-2" %>
            <%= link_to "Clear", products_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
        
        <% if params[:search].present? || (params[:category_id].present? && params[:category_id] != "all") %>
          <div class="mt-3">
            <small class="text-muted">
              <i class="bi bi-funnel me-1"></i>
              Showing results
              <% if params[:search].present? %>
                for "<strong><%= params[:search] %></strong>"
              <% end %>
              <% if params[:category_id].present? && params[:category_id] != "all" %>
                in <strong><%= @categories.find(params[:category_id]).name %></strong>
              <% end %>
              (<%= @products.total_count %> <%= "product".pluralize(@products.total_count) %> found)
            </small>
          </div>
        <% end %>
      </div>
    </div>

    <%# Category Filter Pills %>
    <div class="mb-4">
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "All", products_path, class: "btn btn-sm #{'btn-primary' if params[:category_id].blank?} #{'btn-outline-primary' if params[:category_id].present?}" %>
        <% @categories.each do |category| %>
          <%= link_to category.name, products_path(category_id: category.id), class: "btn btn-sm #{'btn-primary' if params[:category_id] == category.id.to_s} #{'btn-outline-primary' if params[:category_id] != category.id.to_s}" %>
        <% end %>
      </div>
    </div>

    <%# Products Grid %>
    <% if @products.any? %>
      <div class="row">
        <%# Feature 4.1.4 ✯ - View Partials: Product Card %>
        <%= render partial: "products/product_card", collection: @products, as: :product %>
      </div>

      <%# Pagination %>
      <div class="row mt-5">
        <div class="col-12">
          <nav aria-label="Products pagination">
            <%= paginate @products %>
          </nav>
        </div>
      </div>
    <% else %>
      <div class="alert alert-warning text-center">
        <i class="bi bi-search me-2"></i>
        <% if params[:search].present? || params[:category_id].present? %>
          No products found matching your search criteria. Try adjusting your filters.
        <% else %>
          No products found. Please check back later!
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# Features Section %>
<section class="bg-light py-5">
  <div class="container">
    <div class="row text-center">
      <div class="col-md-3 mb-4 mb-md-0">
        <i class="bi bi-hand-thumbs-up text-primary" style="font-size: 2.5rem;"></i>
        <h5 class="mt-3">Handcrafted</h5>
        <p class="text-muted small">Made with care in Winnipeg</p>
      </div>
      <div class="col-md-3 mb-4 mb-md-0">
        <i class="bi bi-leaf text-primary" style="font-size: 2.5rem;"></i>
        <h5 class="mt-3">Natural</h5>
        <p class="text-muted small">Premium natural ingredients</p>
      </div>
      <div class="col-md-3 mb-4 mb-md-0">
        <i class="bi bi-truck text-primary" style="font-size: 2.5rem;"></i>
        <h5 class="mt-3">Fast Shipping</h5>
        <p class="text-muted small">Quick delivery across Canada</p>
      </div>
      <div class="col-md-3">
        <i class="bi bi-heart text-primary" style="font-size: 2.5rem;"></i>
        <h5 class="mt-3">Made with Love</h5>
        <p class="text-muted small">6 years of craftsmanship</p>
      </div>
    </div>
  </div>
</section>
