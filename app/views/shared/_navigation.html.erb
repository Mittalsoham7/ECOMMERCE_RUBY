<%# Feature 4.1.4 ✯ - View Partials %>
<%# Shared navigation partial %>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
      <span class="fs-4 fw-bold text-primary">🕯️ Scented Studio</span>
    <% end %>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
        </li>
        
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Categories
          </a>
          <ul class="dropdown-menu" aria-labelledby="categoriesDropdown">
            <% if @categories.present? %>
              <% @categories.each do |category| %>
                <li><%= link_to category.name, category_path(category), class: "dropdown-item" %></li>
              <% end %>
            <% else %>
              <li><span class="dropdown-item text-muted">No categories available</span></li>
            <% end %>
          </ul>
        </li>
        
        <li class="nav-item">
          <%= link_to "About", "#", class: "nav-link" %>
        </li>
        
        <li class="nav-item">
          <%= link_to "Contact", "#", class: "nav-link" %>
        </li>
        
        <%# Shopping Cart Icon with Badge %>
        <li class="nav-item">
          <%= link_to cart_path, class: "nav-link position-relative" do %>
            <i class="bi bi-cart3 fs-5"></i>
            <% if session[:cart].present? && session[:cart].any? %>
              <% cart_count = session[:cart].values.sum { |item| item['quantity'] } %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= cart_count %>
              </span>
            <% end %>
          <% end %>
        </li>
        
        <%# User Authentication Links (Feature 3.1.4) %>
        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle"></i> <%= current_user.name || current_user.email %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li><%= link_to "My Orders", orders_path, class: "dropdown-item" %></li>
              <li><%= link_to "My Profile", profile_path, class: "dropdown-item" %></li>
              <li><%= link_to "My Addresses", addresses_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-sm ms-2" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
