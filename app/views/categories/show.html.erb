<%# Feature 2.2 - Navigate by category %>

<% content_for :title, "#{@category.name} - Scented Studio" %>

<div class="container py-5">
  <%# Breadcrumb %>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Products", products_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @category.name %></li>
    </ol>
  </nav>

  <%# Category Header %>
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <h1 class="display-4 fw-bold mb-3"><%= @category.name %></h1>
      <p class="lead text-muted"><%= @category.description %></p>
      <div class="mt-3">
        <span class="badge bg-primary fs-6"><%= @products.total_count %> Products</span>
      </div>
    </div>
  </div>

  <%# Category Filter Pills %>
  <div class="mb-4">
    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <%= link_to "All Products", products_path, class: "btn btn-sm btn-outline-primary" %>
      <% @categories.each do |category| %>
        <% if category.id == @category.id %>
          <%= link_to category.name, category_path(category), class: "btn btn-sm btn-primary" %>
        <% else %>
          <%= link_to category.name, category_path(category), class: "btn btn-sm btn-outline-primary" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Products Grid %>
  <% if @products.any? %>
    <div class="row">
      <%# Feature 4.1.4 ✯ - View Partials: Product Card %>
      <%= render partial: "products/product_card", collection: @products, as: :product %>
    </div>

    <%# Pagination %>
    <div class="row mt-5">
      <div class="col-12">
        <nav aria-label="Products pagination">
          <%= paginate @products %>
        </nav>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info text-center">
      <i class="bi bi-info-circle me-2"></i>
      No products found in this category. Please check back later!
    </div>
    <div class="text-center mt-4">
      <%= link_to "Browse All Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
